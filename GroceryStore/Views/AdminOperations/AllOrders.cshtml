@model IEnumerable<Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "AllOrders";
}
<div style="width:100%" class="mt-2">
    <h4> Orders</h4>
    @if (Model != null && Model.Count() > 0)
    {
        <div class="table-responsive">
        <table class="table table-centered table-hover text-nowrap table-borderless mb-0 " id="demo">
                <tr class="bg-light">
                <th>OrderDate</th>
                <th>Name</th>
                <th>Email</th>
                <th>MobileNo</th>
                <th>Address</th>
                <th>PaymentStatus</th>
                <th>OrderStatus</th>
                <th>Actions</th>

            </tr>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.CreateDate.ToString("dd-MM-yyyy")</td>
                    <td>@order.Name</td>
                    <td>@order.Email</td>
                    <td>@order.MobileNumber</td>

                    <td>@order.Address</td>
                    <td>@order.PaymentMethod | @(order.IsPaid ? "Paid" : "Not Paid")</td>
                    <td>@order.OrderStatus.StatusName</td>
                    <td>

                        <button type="button" data-bs-toggle="modal" data-bs-target="#modal-@order.Id" class="btn btn-primary btn-sm">
                            Order-Detail
                        </button>
                        
                        <a asp-action="UpdateOrderStatus" asp-route-orderId="@order.Id" class="btn btn-info btn-sm">Change-Order</a>
                        <a asp-action="TogglePaymentStatus" asp-route-orderId="@order.Id" class="btn btn-info btn-sm">Toggle-Payment</a>


                        
                      
                       
                        
                        
                       
                        @* appending modal div here *@
                        @* Make sure to put this partial tag inside this td block, otherwise it can cause layout related problem*@
                         @await Html.PartialAsync("/Views/AdminOperations/SendEmail.cshtml", new EmailViewModel { DivId = order.Id.ToString(), OrderDetail = order.OrderDetail, ToEmail = order.Email,MobileNumber=order.MobileNumber,Subject="Thanks for the order#"+order.Id }) 
                       
                    </td>

                </tr>




            }
        </table>
        </div>
    }
    else
    {
        <h5>No orders</h5>
    }


</div>
@section Scripts {

    <script>
 const message = document.getElementById("demo").innerText;
    </script>

   
}
