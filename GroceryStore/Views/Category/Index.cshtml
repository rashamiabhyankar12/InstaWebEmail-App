@model IEnumerable<Category>
@{
    Layout = "_AdminLayout";
}

<h2>Categorys</h2>

<a asp-action="AddCategory" asp-controller="Category" class="btn btn-primary">Add More</a>
<div class="table-responsive">
    <table class="table table-centered table-hover text-nowrap table-borderless mb-0">
        <tr class="bg-light">
        <th>Category</th>
        <th>Action</th>
    </tr>

    @foreach(var category in Model)
    {
        <tr>
            <td>@category.CategoryName</td>
            <td>
                <a asp-action="UpdateCategory" asp-controller="Category" asp-route-id="@category.Id" class="btn btn-success"><i class="bi bi-pen"></i></a>
                <a asp-action="DeleteCategory" asp-controller="Category" asp-route-id="@category.Id" class="btn btn-danger" onclick="return window.confirm('Are you sure?')"><i class="bi bi-trash"></i></a>
            </td>
        </tr>
    }
</table>
</div>
