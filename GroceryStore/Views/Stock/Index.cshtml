@model IEnumerable<StockDisplayModel>
@{
    Layout = "_AdminLayout";
}
<h2>Stocks</h2>

<form asp-action="Index" method="get" class="my-2 d-flex gap-2">
    <input type="text" name="sTerm" class="form-control w-25" placeholder="Search by product" />
    <button type="submit" class="btn btn-primary">Find</button>
    <a asp-action="Index" asp-controller="Stock" class="btn btn-primary">Clear</a>
</form>
<div class="table-responsive">
    <table class="table table-centered table-hover text-nowrap table-borderless mb-0">
        <tr class="bg-light">
    <th>Product</th>
    <th>Stock</th>
    <th>Actions</th>
  </tr>
  @foreach(var item in Model)
  {
    <tr>
      <td>@item.ProductName</td>
      <td>@item.Quantity</td>
      <td>
                <a asp-action="ManangeStock" asp-controller="Stock" asp-route-productId="@item.ProductId" class="btn btn-info"> <i class="bi bi-pen"></i></a>
      </td>
    </tr>
  }
</table>
</div>
