@model IEnumerable<Order>
@{
}
<style>
    .avatar {
        vertical-align: middle;
        width: 50px;
        height: 50px;
        border-radius: 50%;
    }
    @@media (min-width: 1025px) {
.h-custom {
height: 100vh !important;
}
}
    .horizontal-timeline .items {
border-top: 2px solid #ddd;
}

.horizontal-timeline .items .items-list {
position: relative;
margin-right: 0;
}

.horizontal-timeline .items .items-list:before {
content: "";
position: absolute;
height: 8px;
width: 8px;
border-radius: 50%;
background-color: #ddd;
top: 0;
margin-top: -5px;
}

.horizontal-timeline .items .items-list {
padding-top: 15px;
}
</style>

 @foreach (var order in Model){
<section class="h-100 h-custom" style="background-color: #eee;">
  <div class="container py-5 h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col-lg-8 col-xl-6">
        <div class="card border-top border-bottom border-3" style="border-color: #f37a27 !important;">
          <div class="card-body p-5">

            <p class="lead fw-bold mb-5" style="color: #f37a27;">Purchase Reciept</p>

            <div class="row">
              <div class="col mb-3">
                <p class="small text-muted mb-1">Date</p>
                <p>@order.CreateDate.ToString("dd-MM-yyyy")</p>
              </div>
              <div class="col mb-3">
                <p class="small text-muted mb-1">Order No.</p>
                <p>@order.Id</p>
              </div>
            </div>
              
            <div class="mx-n5 px-5 py-4" style="background-color: #f2f2f2;">
             

               <div class="table-responsive">
        <table class="table table-centered table-hover text-nowrap table-borderless mb-0">
            <tr class="bg-light">
               
            <th>Product</th>
             <th>Image</th>
            
            <th>Category</th>
            
            <th>Price</th>
             <th>Quantity</th>
                </tr>
                 @foreach (var item in order.OrderDetail){
                 <tr>
                
                <td>@item.Product.ProductName</td>
                <td>
                    @if(string.IsNullOrWhiteSpace(@item.Product.Image))
                    {
                            <img src="/Images/NoImage.png" alt="product image" class="avatar" />
                    }
                    else
                    {
                            <img src="/images/@item.Product.Image" alt="product image" class="avatar" />
                    }
                </td>
                <td>@item.Product.Category.CategoryName</td>
                <td>@item.UnitPrice</td>
                 
                <td>@item.Quantity</td>
                </tr>
                }
                </table>
                </div>




            </div>
            
            <div class="row my-4">
              <div class="col-md-4 offset-md-8 col-lg-3 offset-lg-9">
                <p class="lead fw-bold mb-0" style="color: #f37a27;">£@(order.OrderDetail.Select(item => item.Product.Price * item.Quantity).Sum())</p>
              </div>
            </div>

            <p class="lead fw-bold mb-4 pb-2" style="color: #f37a27;">Tracking Order</p>

            <div class="row">
              <div class="col-lg-12">

                <div class="horizontal-timeline">
@if(order.OrderStatusId==1){
     <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 
                  </ul>
}
  else if(order.OrderStatusId==2)
  {
       <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }
  else if(order.OrderStatusId==3)
  {
      <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }
  else if(order.OrderStatusId==4)
  {
       <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Cancelled</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }
  else if(order.OrderStatusId==5)
  { <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Cancelled</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Returned</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>

  }
  else if(order.OrderStatusId==6)
  {
      <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Cancelled</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Returned</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Refund</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }


                </div>

              </div>
            </div>

           

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
}
