@model IEnumerable<Order>
@{
}
<style>
    .avatar {
        vertical-align: middle;
        width: 50px;
        height: 50px;
        border-radius: 50%;
    }
    @@media (min-width: 1025px) {
.h-custom {
height: 100vh !important;
}
}
    .horizontal-timeline .items {
border-top: 2px solid #ddd;
}

.horizontal-timeline .items .items-list {
position: relative;
margin-right: 0;
}

.horizontal-timeline .items .items-list:before {
content: "";
position: absolute;
height: 8px;
width: 8px;
border-radius: 50%;
background-color: #ddd;
top: 0;
margin-top: -5px;
}

.horizontal-timeline .items .items-list {
padding-top: 15px;
}
</style>
@foreach (var order in Model)
{

<div class="row">
    <div class="col-xl-12 col-12 mb-5">
        <!-- card -->
        <div class="card h-100 card-lg">
            <div class="card-body p-6">
                <div class="d-md-flex justify-content-between">
                    <div class="d-flex align-items-center mb-2 mb-md-0">
                        <h2 class="mb-0">Order ID: #@order.Id</h2>
                      
                    </div>
                    
                   
                </div>
                <div class="mt-8">
                    <div class="row">
                        <!-- address -->
                        <div class="col-lg-4 col-md-4 col-12">
                            <div class="mb-6">
                                <h6>Customer Details</h6>
                                <p class="mb-1 lh-lg">
                                    @order.Name
                                    <br />
                                    @order.Email
                                    <br />
                                    @order.MobileNumber
                                </p>
                                
                            </div>
                        </div>
                        <!-- address -->
                        <div class="col-lg-4 col-md-4 col-12">
                            <div class="mb-6">
                                <h6>Shipping Address</h6>
                                <p class="mb-1 lh-lg">
                                        @order.Address
                                </p>
                            </div>
                        </div>
                        <!-- address -->
                        <div class="col-lg-4 col-md-4 col-12">
                            <div class="mb-6">
                                <h6>Order Details</h6>
                                <p class="mb-1 lh-lg">
                                    Order ID:
                                    <span class="text-dark">@order.Id</span>
                                    <br />
                                    Order Date:
                                        <span class="text-dark">@order.CreateDate.ToString("dd-MM-yyyy")</span>
                                    <br />
                                    Order Total:
                                        <span class="text-dark">£@(order.OrderDetail.Select(item => item.Product.Price * item.Quantity).Sum())</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="table-responsive">
                        <!-- Table -->
                        <table class="table mb-0 text-nowrap table-centered">
                            <!-- Table Head -->
                            <thead class="bg-light">
                                <tr>
                                    <th>Products</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <!-- tbody -->
                            <tbody>
                                @foreach (var item in order.OrderDetail){

                                <tr>
                                    <td>
                                        <a href="#" class="text-inherit">
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <img src="/images/@item.Product.Image" alt="" class="icon-shape icon-lg" />
                                                </div>
                                                <div class="ms-lg-4 mt-2 mt-lg-0">
                                                    <h5 class="mb-0 h6">@item.Product.ProductName</h5>
                                                </div>
                                            </div>
                                        </a>
                                    </td>
                                    <td><span class="text-body">@item.UnitPrice</span></td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice*@item.Quantity</td>
                                </tr>
                             }
                                <tr>
                                    <td class="border-bottom-0 pb-0"></td>
                                    <td class="border-bottom-0 pb-0"></td>
                                   
                                   
                                </tr>
                                <tr>
                                    <td class="border-bottom-0 pb-0"></td>
                                    <td class="border-bottom-0 pb-0"></td>
                                   
                                   
                                </tr>

                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td colspan="1" class="fw-semibold text-dark">
                                        <!-- text -->
                                        Grand Total
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        <!-- text -->
                                        £@(order.OrderDetail.Select(item => item.UnitPrice * item.Quantity).Sum())
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-body p-6">
                <div class="row">
                    <div class="col-md-6 mb-4 mb-lg-0">
                        <h6>Payment Info</h6>
                        <span>@order.PaymentMethod</span>
                    </div>
                   <p class="lead fw-bold mb-4 pb-2" style="color: #f37a27;">Tracking Order</p>

           
              <div class="col-lg-12">

                <div class="horizontal-timeline">
@if(order.OrderStatusId==1){
     <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 
                  </ul>
}
  else if(order.OrderStatusId==2)
  {
       <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }
  else if(order.OrderStatusId==3)
  {
      <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }
  else if(order.OrderStatusId==4)
  {
       <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Cancelled</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }
  else if(order.OrderStatusId==5)
  { <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Cancelled</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Returned</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>

  }
  else if(order.OrderStatusId==6)
  {
      <ul class="list-inline items d-flex justify-content-between">
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Pending</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                 <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Shipped</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Delivered</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Cancelled</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                     <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Returned</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                    <li class="list-inline-item items-list">
                      <p class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">Refund</p
                        class="py-1 px-2 rounded text-white" style="background-color: #f37a27;">
                    </li>
                  </ul>
  }


                </div>

              </div>

               
            </div>
        </div>
    </div>
</div>
</div>
}        