@model ProductDTO
@{
    Layout = "_AdminLayout";
}
<div style="width:50%">
    <h2> Add Product </h2>
    <a asp-action="Index" asp-controller="Product" class="btn btn-primary">Back</a>
    <form asp-action="AddProduct" enctype="multipart/form-data">
        @* <input type="hidden" asp-for="Id" /> *@

        <div class="my-2">
            <label>Product*</label>
            <input type="text" class="form-control" asp-for="ProductName" />
            <span asp-validation-for="ProductName" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label>Description*</label>
            <input type="text" class="form-control" asp-for="Description" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label>Category*</label>
            <select class="form-control" asp-for="CategoryId" asp-items="Model.CategoryList">
                <option value="">Select Category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="my-2">
            <label>SubCategory*</label>
            <select id="box1" class="form-control" asp-for="SubcategoryID" asp-items="Model.SubCategoryList" onChange="myNewFunction(this);">
                <option value="">Select SubCategory</option>
            </select>
            <span asp-validation-for="SubcategoryID" class="text-danger"></span>
        </div>
        <input id="text" type="text"  asp-for=SubcategoryName readonly/>
        <div class="my-2">
            <label>Price*</label>
            <input type="number" class="form-control" asp-for="Price" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="my-2">
            <label>Brand*</label>
            <input type="text" class="form-control" asp-for="Brand" />
            <span asp-validation-for="Brand" class="text-danger"></span>
        </div>
        <div class="my-2">
            <label>Origin*</label>
            <input type="text" class="form-control" asp-for="Origin" />
            <span asp-validation-for="Origin" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label>Image</label>
            <input type="file" class="form-control" asp-for="ImageFile" />
        </div>

        <div class="my-2">
            <button type="submit" class="btn btn-info">Add</button>
        </div>
    </form>
</div>

        @section Scripts{
            <script>
                function myNewFunction(sel) {

           document.getElementById("text").value = sel.options[sel.selectedIndex].text;
        }
       
       
            </script>
        }