
@{
    ViewData["Title"] = "OrderSuccess";
}



<div class="container-fluid  mt-100">
    <div class="row">

        <div class="col-md-12">

            <div class="card">
                <div class="card-header">
                    <h5>Order was successfull</h5>
                </div>
                <div class="card-body cart">
                    <div class="col-sm-12 empty-cart-cls text-center">
                        <img src="/images/order_success_placed.gif" width="130" height="130" class="img-fluid mb-4 mr-3">
                        <h3><strong>Order was successfull</strong></h3>
                        
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary cart-btn-transform m-3" data-abc="true">continue shopping</a>


                    </div>
                </div>
            </div>


        </div>

    </div>

</div>