@model UserReview
@{

    var email = ViewBag.Email;

    var productname = ViewBag.ProductName;

    

}

<h2>UserReview</h2>
<style>
    .star {
  font-size: 10vh;
  cursor: pointer;
}
 
.one {
  color: rgb(255, 0, 0);
}
 
.two {
  color: rgb(255, 106, 0);
}
 
.three {
  color: rgb(251, 255, 120);
}
 
.four {
  color: rgb(255, 255, 0);
}
 
.five {
  color: rgb(24, 159, 14);
}
    </style>
<form asp-action="Review">
    <div class="py-2">
        <label asp-for="Name">Name*</label>
        <input type="text" class="form-control" asp-for="Name" required  />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="py-2">
        <label asp-for="Email">Email*</label>
        <input type="text" class="form-control" asp-for="Email" required value="@email" readonly />
        <span asp-validation-for="Email" class="text-danger"></span>

    </div>

    <div class="py-2">
        <label asp-for="MobileNumber">MobileNumber*</label>
        <input type="text" class="form-control" asp-for="MobileNumber" required />
        <span asp-validation-for="MobileNumber" class="text-danger"></span>
    </div>


    <div class="py-2">
        <label asp-for="Comment">Comment*</label>
        <textarea class="form-control" asp-for="Comment" rows="5" required> </textarea>
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>

    <div class="py-2">
        <label asp-for="ProductName">ProductName*</label>
        <input type="text" class="form-control" asp-for="ProductName" required value="@productname" readonly />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="py-2">
        <label asp-for="Ratings">Ratings*</label>
        <input type="number" class="form-control" asp-for="Ratings" min="1" max="5" required />
        <span asp-validation-for="Ratings" class="text-danger"></span>
    </div>



    <div class="py-2">
        <button type="submit" c class="btn btn-info">Next</button>

    </div>
</form>




