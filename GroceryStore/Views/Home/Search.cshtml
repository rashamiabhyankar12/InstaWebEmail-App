@model ProductDisplayModel

<style>
  
        .owl-thumbs .owl-thumb-item {
            height: 150px;
            width: 100%;
            max-width: 150px;
            background: transparent;
            border: none;
            overflow: hidden;
        }

            .owl-thumbs .owl-thumb-item img {
                max-width: 100%;
                height: auto;
            }

        .owl-thumbs .owl-thumb-item:nth-child(2) {
            transform: rotate(180deg);
        }

        .owl-thumbs .owl-thumb-item:nth-child(3) {
            transform: rotate(90deg);
        }

        .owl-thumbs .owl-thumb-item:nth-child(4) {
            transform: rotate(-90deg);
        }
    .owl-dots {
        position: absolute;
        bottom: 170px;
        left: 0;
        right: 0;
    }
    .sv-slider-item img {
        width: 100%;
        height: 200px;
    }

    .sv-slider .owl-thumbs {
        white-space: nowrap;
        overflow: auto;
    }

    .owl-thumbs button > img {
        width: 200px;
        height: 100px;
       
    }
    
    .offcanvas-backdrop {
        display: none;
    }


    .card {
        margin-right: 10px !important;
    }

    .store-card {
        transition: all 0.2s ease;
    }

        .store-card:hover {
            transform: scale(1.03);
            box-shadow: lightgray 2px 5px 5px 2px;
        }

    .accent {
        accent-color: green;
    }

    fieldset.group {
        margin: 0;
        padding: 0;
        margin-bottom: 1.25em;
        padding: .125em;
    }

        fieldset.group legend {
            margin: 0;
            padding: 0;
            font-weight: bold;
            margin-left: 20px;
            font-size: 100%;
            color: black;
        }


    ul.checkbox {
        margin: 0;
        padding: 0;
        margin-left: 20px;
        list-style: none;
        overflow-x: scroll;
    }

        ul.checkbox li input {
            margin-right: .25em;
        }

        ul.checkbox li {
            border: 1px transparent solid;
            display: inline-block;
            width: 12em;
        }

            ul.checkbox li label {
                margin-left:;
            }

            ul.checkbox li:hover,
            ul.checkbox li.focus {
                background-color: lightyellow;
                border: 1px gray solid;
                width: 12em;
            }

        ul.checkbox li {
            border: 1px transparent solid;
            display: inline-block;
            width: 12em;
        }

    .img_producto_container {
        /* width: 100%;
            height: 100%; */
        position: relative;
        overflow: hidden;
        cursor: crosshair;
    }

    .img_producto {
        /* position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%; */
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
        transition: transform 0.5s ease-out;
    }

    .f_btn {
        padding: 8px 20px;
        border: 2px solid #089da1;
        text-decoration: none;
        color: #000;
    }

    .fa-heart {
        font-size: 20px;
    }

    #snackbar {
        visibility: hidden;
        min-width: 250px;
        margin-left: -125px;
        background-color: #333;
        color: #fff;
        text-align: center;
        border-radius: 2px;
        padding: 16px;
        position: fixed;
        z-index: 1;
        left: 50%;
        bottom: 30px;
        font-size: 17px;
    }

        #snackbar.show {
            visibility: visible;
            -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }
</style>

<div class="mt-8 mb-lg-14 mb-8">
    <!-- container -->
    <div class="container">
        <!-- breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Home/Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Search" asp-route-sterm="@Model.STerm">@Model.STerm</a></li>


            </ol>
        </nav>

        <!-- row -->
        <div class="row gx-10">
            <aside class="col-lg-3 col-md-4 mb-6 mb-md-0">



                <div class="offcanvas offcanvas-start offcanvas-collapse w-md-50" data-bs-backdrop="static" tabindex="-1" id="offcanvasCategory" aria-labelledby="offcanvasCategoryLabel">
                    <div class="offcanvas-header d-lg-none">
                        <h5 class="offcanvas-title" id="offcanvasCategoryLabel">Filter</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body ps-lg-2 pt-lg-0">
                        <div class="mb-8">
                            <!-- title -->
                            <h5 class="mb-3">Sub-Categories</h5>
                            <!-- nav -->
                            <ul class="nav nav-category" id="categoryCollapseMenu">
                                <li class="nav-item border-bottom w-100">
                                    @foreach (var item in Model.Subcategory.DistinctBy(x => x.SubcategoryName))
                                    {

                                        <a asp-action="Search" asp-route-sub="@item.SubcategoryID" asp-route-sterm="@Model.STerm"
                                           class="nav-link collapsed">
                                            @item.SubcategoryName
                                            <i class="fa-solid fa-chevron-right"></i>

                                        </a>
                                    }
                                </li>
                            </ul>
                        </div>
                        <form id="myform" asp-action="Search" asp-route-sterm="@Model.STerm">

                            <div class="mb-8">
                                <h5 class="mb-3">Brands</h5>
                                <div style="overflow:hidden">
                                    <div style="height:100px;   overflow-y: scroll;">
                                        <!-- form check -->
                                        @foreach (var item in Model.Brands.DistinctBy(x => x.Brand))
                                        {

                                            <div class="form-check mb-2">

                                                <label id="Brand"><input type="checkbox" name="Brand" value="@item.Brand" class="Brand form-check-input" onsubmit="submit()">@item.Brand</label><br>


                                            </div>


                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="mb-8">
                                <h5 class="mb-3">Origins</h5>
                                <div style="overflow:hidden">
                                    <div style="height:100px;   overflow-y: scroll;">
                                        <!-- form check -->
                                        @foreach (var item in Model.Brands.DistinctBy(x => x.Origin))
                                        {
                                            <div class="form-check mb-2">

                                                <label id="Origin"><input type="checkbox" name="Origin" value="@item.Origin" class="Origin form-check-input" onsubmit="submit()">@item.Origin</label><br>


                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <br />
                       
                            <div class="mb-8">
                                <h5 class="mb-3">Price</h5>
                                <input class="accent" id="slider" type="range" min="@Model.Products.Min(x=>x.Price)" max="@Model.Products.Max(x=>x.Price)" step="10" onchange="sliderChange(this.value)" asp-route-slider="value" asp-action="Search">
                                <output id="output" asp-route-slider="value" asp-action="Search"></output>

                            </div>

                            <input type="text" hidden id="search" value="@Model.STerm" />








                        </form>
                    </div>
                </div>

            </aside>
            <section class="col-lg-9 col-md-12">
                <!-- card -->
                <div class="card mb-4 bg-light border-0">
                    <!-- card body -->
                    @if (Model.CategoryId == 1)
                    {
                        <img src="~/images/fruits.jpg" />
                    }
                    @if (Model.CategoryId == 2)
                    {
                        <img src="~/images/vegetables.jpg" />
                    }
                    @if (Model.CategoryId == 3)
                    {
                        <img src="/images/dairy.jpg" />
                    }


                </div>
                <div class="d-lg-flex justify-content-between align-items-center">
                    <div class="mb-3 mb-lg-0">
                        <p class="mb-0" id="link">
                            <span class="text-dark">@Model.Products.Count()</span>
                            Products found

                        </p>
                    </div>
                </div>
                <div class="ms-2 d-lg-none">
                    <a class="btn btn-outline-gray-400 text-muted" data-bs-toggle="offcanvas" href="#offcanvasCategory" role="button" aria-controls="offcanvasCategory">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="feather feather-filter me-2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filters
                    </a>
                </div>
                <div class="row g-4 row-cols-xl-4 row-cols-lg-3 row-cols-2 row-cols-md-2 mt-2">
                    @foreach (var item in Model.Products)
                    {

                        <!-- col -->
                        <div class="col">
                            <!-- card -->
                            <div class="card card-product">
                                <div class="card-body">
                                    <!-- badge -->
                                    <div class="text-center position-relative">
                                        <div class="position-absolute top-0 start-0">
                                            @if (item.Quantity > 0)
                                            {
                                                <span class="badge bg-danger">Sale</span>

                                                <span class="custom-badge  badge text-dark bg-warning">@item.Quantity</span>
                                            }
                                        </div>
                                        <a>
                                            <!-- img -->
                                            <img src="/images/@item.Image" alt="Grocery Ecommerce Template" class="mb-3 img-fluid" />
                                        </a>
                                        <!-- action btn -->
                                        <div class="card-product-action">
                                            <a href="#!" class="btn-action" data-bs-toggle="modal" data-bs-target="#myModal{{@item.Id}}">
                                                <i class="bi bi-eye" data-bs-toggle="tooltip" data-bs-html="true" title="Quick View"></i>
                                            </a>
                                            <a class="btn-action" data-bs-toggle="tooltip" data-bs-html="true" title="Wishlist"><i class="far fa-heart" id="@item.Id"></i></a>

                                        </div>
                                    </div>
                                    <!-- heading -->
                                    <div class="text-small mb-1">
                                        <a href="#!" class="text-decoration-none text-muted"><small>@item.CategoryName</small></a>
                                    </div>
                                    <h2 class="fs-6"><a class="a-cleanup" asp-controller="Home" asp-action="Details" asp-route-Id="@item.Id" asp-route-categoryId="@item.CategoryId" asp-route-ProductName="@item.ProductName" class="text-inherit text-decoration-none">@item.ProductName</a></h2>
                                    <div>
                                        <!-- rating -->
                                        <small class="text-warning">
                                            <span class="stars" data-rating=@Model.UserReviews.Where(x => x.ProductName == item.ProductName).Average(x => x.Ratings) data-num-stars="5"></span>
                                        </small>
                                        <span class="text-muted small">
                                            (@Model.UserReviews.Where(x => x.ProductName == item.ProductName).Count())
                                        </span>
                                    </div>
                                    <!-- price -->
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div>
                                            <span class="text-dark">£@item.Price</span>
                                            <span class="text-decoration-line-through text-muted">£24</span>
                                        </div>
                                        <!-- btn -->
                                        <div>
                                            @if (item.Quantity > 0)
                                            {


                                                <a href="#!" class="btn btn-primary btn-sm" onclick="add(@item.Id)">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         width="16"
                                                         height="16"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round"
                                                         class="feather feather-plus">
                                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                    Add
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="#!" class="btn btn-danger btn-sm"> Sold Out </a>

                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
<div id="snackbar"></div> 
<input hidden id="search" value="@Model.STerm" />
