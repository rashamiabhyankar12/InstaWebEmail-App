    <script>
                function sliderChange(val) {
            document.getElementById('output').innerHTML = val;

        }
        document.getElementById('slider').value = 0;
    </script>
    <script>

                      $(function () {



            jQuery("input:checkbox").change(function () {
                if ($('input:checkbox').is(':checked')) {




                    var data = [],
                    loc = $('<a>', { href: window.location })[0];
                    var Brand = [];
                    var Origin = [];

                    if (window.location.href.indexOf(this.name) > -1) {

                        $('input[type="checkbox"]').each(function (i) {
                        if (this.checked) {
                            if (this.name == 'Brand') {
                                Brand.push(this.value);
                            } else if (this.name = 'Origin') {
                                Origin.push(this.value);
                            }

                        }
                    });
                    if (Brand.length != 0) {
                        data.push('Brand=' + (Brand.length > 1 ? Brand.join(',') : Brand[0]));
                    }
                    if (Origin.length != 0) {
                        data.push('Origin=' + (Origin.length > 1 ? Origin.join(',') : Origin[0]));
                    }

                    data = data.join('&');

                    $('p').html(data);

                   var array = [];
                   array.push(document.getElementById('link').innerText.substring(6).replace("=",""));

                     window.location.href += "," +array;
                    }
                       $('input[type="checkbox"]').each(function (i) {
                        if (this.checked) {
                            if (this.name == 'Brand') {
                                Brand.push(this.value);
                            } else if (this.name = 'Origin') {
                                Origin.push(this.value);
                            }
                        }
                    });
                    if (Brand.length != 0) {
                        data.push('Brand=' + (Brand.length > 1 ? Brand.join(',') : Brand[0]));
                    }

                    if (Origin.length != 0) {
                        data.push('Origin=' + (Origin.length > 1 ? Origin.join(',') : Origin[0]));
                    }
                    data = data.join('&');

                    $('p').html(data);
                     const paragraphText = document.getElementById('link').innerText;
                      //window.location.href += "&"+document.getElementById('link').innerText;
                      location.replace(window.location.origin+"/Home/Search?sterm="+document.getElementById("search").value+"&"+document.getElementById('link').innerText);
                }
            });
        });


         var i = window.location.href.lastIndexOf('&');

        var types = (window.location.href.substring(i+1).replace(/Brand=/g,'').split(','));

                 function cleanStrings(arr) {
          return arr.map(str => decodeURI(str));
        }
        var cleanedArray = cleanStrings(types);

        var origins = window.location.href.substring(i+1).replace(/Origin=/g,'').split(',');
          var clean =cleanStrings(origins);
        $('input[name="Brand"]').prop('checked',function(){
             return $.inArray(this.value,cleanedArray) !== -1;

        });
         $('input[name="Origin"]').prop('checked',function(){
             return $.inArray(this.value,clean) !== -1;
        });


    </script>

    <script>
        async function add(productId) {
            var usernameEl = document.getElementById("username");
            if (usernameEl == null) {
                window.location.href = "/Identity/Account/Login";
                //var username=usernameEl.innerText;
                //  if(username.length<1){
                //      window.location.href="/Identity/Account/Login";
                //  }
            }
            try {
                var response = await fetch(`/Cart/AddItem?productId=${productId}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("cartCount");
                    cartCountEl.innerHTML = result;
                    window.location.href = "#cartCount";
                }
            }
            catch (err) {
                console.log(err);
            }
        }

        $(".far").click(function () {
            $(this).toggleClass("far fas");
            if ($(this).hasClass("fas")) {
                wishlist(this.id, 1)
            } else {
                removewishlist(this.id, 1)
            }
        });

        //wishlist
        async function wishlist(productId, qty) {

            var usernameEl = document.getElementById("username");
            if (usernameEl == null) {
                window.location.href = "/Identity/Account/Login";
                //var username=usernameEl.innerText;
                //  if(username.length<1){
                //      window.location.href="/Identity/Account/Login";
                //  }
            }
            try {

                var x = document.getElementById("snackbar");
                x.className = "show";
                setTimeout(function () { x.className = x.className.replace("show", ""); }, 3000);
                $('#snackbar').html('added to wishlist');
                //
                //
                var response = await fetch(`/Cart/AddWishlist?productId=${productId}&qty=${qty}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("wishlistCount");
                    cartCountEl.innerHTML = result;
                    window.location.href = "#wishlistCount";


                }
            }

            catch (err) {
                console.log(err);
            }
        }

        //remove wishlist
        async function removewishlist(productId, qty) {

            var usernameEl = document.getElementById("username");
            if (usernameEl == null) {
                window.location.href = "/Identity/Account/Login";
                //var username=usernameEl.innerText;
                //  if(username.length<1){
                //      window.location.href="/Identity/Account/Login";
                //  }
            }
            try {

                var x = document.getElementById("snackbar");
                x.className = "show";
                setTimeout(function () { x.className = x.className.replace("show", ""); }, 3000);
                $('#snackbar').html('removed from wishlist');
                //
                //


                var response = await fetch(`/Cart/RemoveWishlist?productId=${productId}&qty=${qty}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("wishlistCount");
                    cartCountEl.innerHTML = result;
                    window.location.href = "#wishlistCount";

                }
            }
            catch (err) {
                console.log(err);
            }

        }


    </script>
    <script>
        $(".img_producto_container")
            // tile mouse actions
            .on("mouseover", function () {
                $(this)
                    .children(".img_producto")
                    .css({ transform: "scale(" + $(this).attr("data-scale") + ")" });
            })
            .on("mouseout", function () {
                $(this)
                    .children(".img_producto")
                    .css({ transform: "scale(1)" });
            })
            .on("mousemove", function (e) {
                $(this)
                    .children(".img_producto")
                    .css({
                        "transform-origin":
                            ((e.pageX - $(this).offset().left) / $(this).width()) * 100 +
                            "% " +
                            ((e.pageY - $(this).offset().top) / $(this).height()) * 100 +
                            "%"
                    });
            });

    </script>
    <script>
        jQuery(document).ready(function($) {
                $.fn.stars = function() {
            return $(this).each(function() {
                const rating = $(this).data("rating");
                const numStars = $(this).data("numStars");
                const fullStar = '<i class="fas fa-star"></i>'.repeat(Math.floor(rating));
                const halfStar = (rating%1!== 0) ? '<i class="fas fa-star-half-alt"></i>': '';
                const noStar = '<i class="far fa-star"></i>'.repeat(Math.floor(numStars-rating));
                $(this).html(`${fullStar}${halfStar}${noStar}`);
            });
        }

        $(function(){
                $('.stars').stars();
            });
           });
    </script>
}